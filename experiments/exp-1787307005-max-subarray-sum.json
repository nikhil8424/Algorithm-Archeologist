    {
      "id": "cand-03-prefix-sum-arra",
      "name": "Prefix Sum Array Sweep",
      "paradigm": "Prefix Reductions",
      "strategy_description": "Compute running prefix sums and track running minimum prefix.",
      "code": "def solve(arr):\n    if not arr:\n        return 0\n    min_prefix = 0\n    running = 0\n    max_sum = arr[0]\n    for x in arr:\n        running += x\n        max_sum = max(max_sum, running - min_prefix)\n        min_prefix = min(min_prefix, running)\n    return max_sum\n",
      "origin": "initial_plan",
      "generation": 0,
      "parent_id": null,
      "mutation_description": null,
      "complexity": {
