    {
      "id": "cand-04-naive-brute-for",
      "name": "Naive Brute Force Cubic",
      "paradigm": "Exhaustive Iteration",
      "strategy_description": "Iterate over all (i, j) subarray endpoints and recompute sum.",
      "code": "def solve(arr):\n    if not arr:\n        return 0\n    # Limited to small N to prevent complete freeze\n    max_so_far = arr[0]\n    for i in range(min(len(arr), 100)):\n        for j in range(i, min(len(arr), 100)):\n            curr = sum(arr[i:j+1])\n            if curr > max_so_far:\n                max_so_far = curr\n    return max_so_far\n",
      "origin": "initial_plan",
